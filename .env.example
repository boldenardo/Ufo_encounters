# ─────────────────────────────────────────────────────────────────────────────
# UFO Encounters — environment variables
#
# 1. Copy this file to .env.local
# 2. Fill in real keys
# 3. NEVER commit .env.local (it's gitignored)
#
# In production (Vercel): set these in Project → Settings → Environment Variables.
# Mark all 3 environments: Production, Preview, Development.
# ─────────────────────────────────────────────────────────────────────────────


# ── CLIENT-SIDE (exposed in browser bundle) ─────────────────────────────────
# Anything prefixed with VITE_ is bundled into the JS sent to the browser.
# Only put PUBLIC keys here — never secrets.

# MapTiler tiles for the 3D globe.
# Get yours: https://cloud.maptiler.com/account/keys/
# Restrict to allowed origins after creating: localhost:5173, *.vercel.app, your domain
VITE_MAPTILER_KEY=


# ── SERVER-SIDE (Vercel Functions only, NEVER bundled) ──────────────────────
# These have NO VITE_ prefix. They live only on the server.
# Used by api/*.ts endpoints.

# Groq API key — powers /api/chat (LLM Q&A about UAP cases)
# Get yours: https://console.groq.com/keys
GROQ_API_KEY=
